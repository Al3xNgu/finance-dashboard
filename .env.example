# Copy to .env and fill in. NEVER commit .env.
# Every variable is validated at startup in src/server/lib/env.ts — the app
# fails fast with a readable error if something is missing or malformed.

# ---------- Core ----------
NODE_ENV=development

# Postgres connection. Local Homebrew Postgres or docker-compose (see docker-compose.yml).
DATABASE_URL=postgresql://localhost:5432/finance_dashboard

# ---------- Auth (used from M1) ----------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Optional OAuth provider — enables Google sign-in when both are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Plaid (used from M2) ----------
# sandbox | production — switching environments is env-only, zero code changes
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Public URL Plaid sends webhooks to (e.g. an ngrok tunnel in dev)
PLAID_WEBHOOK_URL=

# 32-byte base64 key for AES-256-GCM encryption of Plaid access tokens.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# ---------- Background jobs (used from M3) ----------
# inprocess (dev, zero infra) | bullmq (prod, requires REDIS_URL)
QUEUE_DRIVER=inprocess
REDIS_URL=
